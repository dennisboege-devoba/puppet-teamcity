{
  "name": "grundic-teamcity",
  "version": "3.0.0",
  "author": "grundic",
  "summary": "Puppet module to install and configure Teamcity",
  "license": "Apache-2.0",
  "source": "https://github.com/grundic/puppet-teamcity",
  "project_page": "https://github.com/grundic/puppet-teamcity",
  "issues_url": "https://github.com/grundic/puppet-teamcity/issues",
  "tags": [
    "TeamCity",
    "JetBrains",
    "CI",
    "Continues Integration"
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": [
        "12",
        "13"
      ]
    },
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "22.04",
        "24.04"
      ]
    },
    {
      "operatingsystem": "RedHat",
      "operatingsystemrelease": [
        "8",
        "9"
      ]
    },
    {
      "operatingsystem": "SLES",
      "operatingsystemrelease": [
        "15"
      ]
    }
  ],
  "requirements": [
    {
      "name": "openvox",
      "version_requirement": ">= 8.0.0 < 9.0.0"
    }
  ],
  "dependencies": [
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 9.0.0 < 11.0.0"
    },
    {
      "name": "puppetlabs/inifile",
      "version_requirement": ">= 6.0.0 < 7.0.0"
    },
    {
      "name": "puppet/archive",
      "version_requirement": ">= 7.0.0 < 10.0.0"
    }
  ]
}
